<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <attribution
        android:tag="neuroAudio"
        android:label="@string/media3_audio_label" />

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- Required for the Car App Library media template (category.MEDIA) -->
    <uses-permission android:name="androidx.car.app.MEDIA_TEMPLATES" />

    <!-- Android TV: run on TV without requiring touch, appear in the TV launcher -->
    <uses-feature
        android:name="android.software.leanback"
        android:required="false" />
    <uses-feature
        android:name="android.hardware.touchscreen"
        android:required="false" />

    <application
        android:name=".NeuroKaraokeApp"
        android:allowBackup="true"
        android:enableOnBackInvokedCallback="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/neuro"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/neuro_round"
        android:supportsRtl="true"
        android:banner="@drawable/tv_banner"
        android:theme="@style/Theme.NeuroKaraoke">

        <!-- Car App Library minimum API level. Level 8 is required for the
             category.MEDIA template host. -->
        <meta-data
            android:name="androidx.car.app.minCarApiLevel"
            android:value="8" />

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:theme="@style/Theme.NeuroKaraoke"
            android:launchMode="singleTask"
            android:attributionTags="neuroAudio">
            <intent-filter>
                <category android:name="android.intent.category.LEANBACK_LAUNCHER" />
            </intent-filter>
        </activity>

        <service
            android:name=".service.MediaPlaybackService"
            android:exported="true"
            android:foregroundServiceType="mediaPlayback"
            android:attributionTags="neuroAudio">
            <intent-filter>
                <action android:name="androidx.media3.session.MediaLibraryService" />
                <action android:name="androidx.media3.session.MediaSessionService" />
                <!-- Android Auto / legacy MediaBrowser clients -->
                <action android:name="android.media.browse.MediaBrowserService" />
            </intent-filter>
        </service>
    </application>

</manifest>
